{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "export NEXT_TELEMETRY_DISABLED=1 && node scripts/fetch-posters.mjs && next build && node scripts/finalize-export.mjs && node scripts/seo/export-guards.mjs && node scripts/seo/generate-sitemap.mjs && node scripts/build-server.mjs && bash scripts/qa/content-gates.sh --auto dist/public",
    "test:seo": "node --test scripts/seo/*.test.mjs",
    "seo:stamp-check": "node scripts/seo/stamp-lastmod.mjs --check",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.2",
    "drizzle-zod": "^0.6.0",
    "express": "^4.21.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@sparticuz/chromium": "^147.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "4.17.21",
    "@types/node": "22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "axe-core": "4.14.0",
    "drizzle-kit": "^0.27.1",
    "esbuild": "^0.24.0",
    "happy-dom": "^20.0.10",
    "postcss": "^8.4.47",
    "puppeteer-core": "^24.42.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.0.4"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
